[Unit]
Description=Jeff Telegram OpenCode bot
After=network-online.target opencode.service
Wants=network-online.target
Requires=opencode.service

[Service]
Type=simple
User=tray
WorkingDirectory=/home/tray/projects/jeff
EnvironmentFile=/home/tray/projects/jeff/.env
ExecStart=/home/tray/projects/jeff/bin/jeff
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
